{
  "name": "@mfe-store",
  "private": true,
  "version": "0.0.0",
  "description": "A non-trivial micro-frontends example store: lazy-loaded web components from three independently deployed teams, in three frameworks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vitocal/mfe-tractor-store.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build --workspaces && vite build",
    "build:ssg": "APP_TYPE=ssr npm run build",
    "preview": "vite preview",
    "preview:ssg": "npm run build:ssg && vite preview",
    "bench": "npm run build && node scripts/bench-render.ts",
    "report": "node scripts/weight-report.ts",
    "test": "npm test --workspaces"
  },
  "workspaces": [
    "explore",
    "decide",
    "checkout"
  ],
  "dependencies": {
    "ce-autoloader": "^0.2.0-rc"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "vite": "^8.3.1"
  }
}
